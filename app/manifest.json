{
  "manifest_version": 3,
  "name": "Заметки",
  "version": "1.0.0",
  "minimum_chrome_version": "128",
  "description": "Личные Markdown-заметки: папки, теги, поиск, резервная копия на диск.",
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Открыть заметки",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?view=panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "index.html"
}
