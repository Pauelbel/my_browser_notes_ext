{
  "manifest_version": 3,
  "name": "Помощник",
  "version": "2.5.3",
  "minimum_chrome_version": "128",
  "description": "ИИ-помощник в боковой панели на локальных моделях Ollama, с Markdown-заметками.",
  "permissions": [
    "sidePanel",
    "storage",
    "debugger",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Открыть помощника",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?view=panel"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "index.html"
}
